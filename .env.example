# ══════════════════════════════════════════════════════════════════════
#  Framewrk configuration
#
#  Everything in the FIRST section is read once, on the first start, and
#  copied into the database. After that you manage it in the web console
#  at http://<host>:8770 — editing it here has no effect.
#
#  To push these values back into the database, set:
#      FRAMEWRK_RESEED_FROM_ENV=1
#  start once, then remove it again.
#
#  Starting fresh? You can skip the whole first section and set
#  everything up in the console instead.
# ══════════════════════════════════════════════════════════════════════

# ── Read once, then managed in the console ────────────────────────────

# PhotoPrism, the photo source
# A hostname on your network, or the container name if PhotoPrism
# is on the same Docker network.
PHOTOPRISM_URL=http://photoprism:2342
PHOTOPRISM_USERNAME=admin
PHOTOPRISM_PASSWORD=your_password_here

# Aura Frames (optional)
AURA_EMAIL=your_email@example.com
AURA_PASSWORD=your_password_here
# name:image_size[:orientation], comma-separated
AURA_FRAMES=Living Room:fit_2560:all,Kitchen:fit_1920:landscape

# Nixplay (optional)
# Nixplay uploads go into an ALBUM, which is then played by zero or more
# frames. Name the album to sync into; assign it to frames in the console.
NIXPLAY_EMAIL=your_email@example.com
NIXPLAY_PASSWORD=your_password_here
NIXPLAY_ALBUM_NAME=PhotoPrism Sync
NIXPLAY_THUMBNAIL_SIZE=fit_1280
NIXPLAY_ORIENTATION=all

# Which photos to sync: all | favorites | albums | recent
# This is the household default. Any frame can override it in the console —
# except the interval, so there is one schedule for everything.
SYNC_MODE=all
SYNC_ALBUMS=
SYNC_RECENT_DAYS=30
# Minimum PhotoPrism quality score, 0-5
SYNC_QUALITY=3
SYNC_INTERVAL_MINUTES=60
# Photos per run, 0 for no limit
BATCH_SIZE=50

# ── Always read from the environment ──────────────────────────────────

DB_PATH=/data/sync.db

# Web console
FRAMEWRK_PORT=8770
FRAMEWRK_BIND=0.0.0.0

# Sets the admin password on first start. Leave it unset and Framewrk
# generates one and prints it to the container log. Either way you are
# asked to change it at first sign-in.
# FRAMEWRK_ADMIN_PASSWORD=

# Turn on ONLY when a reverse proxy or tunnel sits in front, so
# X-Forwarded-* headers can be believed. On a plain LAN, leaving this off
# stops anyone from spoofing their address past the login throttle.
# FRAMEWRK_TRUST_PROXY=1

# Re-apply the values above to the database on next start
# FRAMEWRK_RESEED_FROM_ENV=1
